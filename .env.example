# 1. Provide your Google Cloud OAuth credentials for the Gmail API
GOOGLE_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"
GOOGLE_REFRESH_TOKEN="1//<your-google-refresh-token>"

# 2. Provide your AI Model API Keys (required: at least one)
GEMINI_API_KEY="<your-gemini-api-key>"
ANTHROPIC_API_KEY="<your-anthropic-api-key>"

# 3. Setup Auth credentials
ADMIN_TOKEN="change_this_to_a_secure_password"
SECRET_SESSION="change_this_to_a_random_string_for_cookie_signing"

# 4. Optional Configurations 
# DB_PATH="triage.db"
# COOKIE_SECURE="false" # set to true if running behind https in prod
