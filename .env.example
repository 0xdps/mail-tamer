# 1. Provide your Google Cloud OAuth credentials for the Gmail API
GOOGLE_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"
GOOGLE_REFRESH_TOKEN="1//<your-google-refresh-token>"

# 2. Provide your AI Model API Keys (required: at least one)
GEMINI_API_KEY="<your-gemini-api-key>"
ANTHROPIC_API_KEY="<your-anthropic-api-key>"

# 3. Setup Auth credentials
ADMIN_TOKEN="change_this_to_a_secure_password"
SECRET_SESSION="change_this_to_a_random_string_for_cookie_signing"

# 4. Optional Configurations 
# DB_PATH="triage.db"
# COOKIE_SECURE="false"         # set to true if running behind https in prod

# 5. Default settings (seed values — overridden in DB once changed via UI)
# POLL_INTERVAL_MINUTES="5"     # how often the scheduler checks for new emails
# AI_MODEL="gemini-2.0-flash"   # default AI model for classification
# CONFIDENCE_THRESHOLD="0.85"   # minimum confidence to auto-apply a label
# DRY_RUN="false"               # set to true to preview without applying labels
# BATCH_SIZE="50"               # number of emails per AI classification batch
# SCHEDULER_ENABLED="false"      # set to false to start with scheduler paused
